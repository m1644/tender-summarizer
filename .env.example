# Application
APP_NAME=Tender Documentation Summarizer
APP_VERSION=2.1.0
DEBUG=false

# File processing
MAX_FILE_SIZE_MB=20

# Chunking
CHUNK_SIZE=12000
CHUNK_OVERLAP=1000

# LLM provider: openai or ollama
LLM_PROVIDER=openai
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=120

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# OCR
ENABLE_OCR=true
OCR_LANGUAGE=rus+eng
OCR_DPI=200
